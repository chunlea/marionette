# API URLs. Leave unset for a deployed build: the SPA is served by the admin
# server, which proxies /api/v1 through to the public API, so relative paths
# reach both. These exist for pointing a dev server at remote backends.
VITE_API_URL=http://localhost:8080
VITE_ADMIN_URL=http://localhost:8081

# WebSocket host override. Unset means the host the page was served from.
VITE_WS_HOST=

# The streaming subsystem (desktop WebRTC, Android mirroring) is frozen and its
# UI is hidden unless this is "true". See src/lib/features.ts.
VITE_ENABLE_STREAMING=false
