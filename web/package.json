{
  "name": "marionette-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "generate:api": "openapi-typescript ../pkg/server/api/openapi.yaml -o src/types/api.gen.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-alpha.10",
    "@tanstack/react-query": "^5.60.5",
    "@tanstack/react-router": "^1.95.1",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/router-devtools": "^1.95.1",
    "@tanstack/router-plugin": "^1.95.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
