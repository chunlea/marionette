# Marionette Agent Dockerfile
# Multi-stage build with runtime tools for AI agent execution

# =============================================================================
# Build stage
# =============================================================================
# See Dockerfile.server for why the builder stays on the native platform and
# cross-compiles. The runtime stage below does run emulated (apt-get), which is
# the slow part of an arm64 build and the reason QEMU is set up in the workflow.
FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS builder

# Toolchain pins. Keep in sync with .github/workflows/ci.yml and the Makefile.
ARG BUF_VERSION=v1.72.0
ARG PROTOC_GEN_GO_VERSION=v1.36.11
ARG PROTOC_GEN_GO_GRPC_VERSION=v1.6.2

# Install buf and protobuf plugins for code generation
RUN go install "github.com/bufbuild/buf/cmd/buf@${BUF_VERSION}" && \
    go install "google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION}" && \
    go install "google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GO_GRPC_VERSION}"

WORKDIR /app

# Copy go mod files first for dependency caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Generate protobuf code
RUN buf generate

# Version stamping. Inert until cmd/agent declares the vars; see
# docs/development/releasing.md.
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

# Build the agent binary
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildDate=${BUILD_DATE}" \
    -o /agent ./cmd/agent

# =============================================================================
# Runtime stage
# =============================================================================
FROM debian:bookworm-slim

# Links the published package to this repository on ghcr, which is also what
# lets GITHUB_TOKEN push it from Actions without a personal token.
LABEL org.opencontainers.image.source="https://github.com/chunlea/marionette"
LABEL org.opencontainers.image.description="Marionette runner agent: runs a coding agent inside a runner"
LABEL org.opencontainers.image.licenses="MIT"

# Install runtime dependencies commonly needed by AI agents
# - ca-certificates: HTTPS connections
# - git: Version control operations
# - curl: HTTP requests
# - jq: JSON processing
# - openssh-client: Git SSH operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    curl \
    jq \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Create workspace directory with proper permissions
RUN mkdir -p /workspace && chown 1000:1000 /workspace

# Copy the binary from builder
COPY --from=builder /agent /usr/local/bin/agent

# Run as non-root user (UID 1000)
USER 1000:1000

# Set working directory
WORKDIR /workspace

# Entry point
ENTRYPOINT ["agent"]
