# Marionette Agent with Desktop Streaming (Selkies GStreamer)
# For testing desktop streaming functionality

# =============================================================================
# Build stage - compile marionette agent
# =============================================================================
FROM golang:1.25-bookworm AS builder

# Install buf and protobuf plugins
RUN go install github.com/bufbuild/buf/cmd/buf@latest && \
    go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN buf generate

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /agent ./cmd/agent

# =============================================================================
# Runtime stage - Selkies GStreamer environment
# =============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99
ENV PULSE_SERVER=unix:/run/pulse/native

# Install X11, GStreamer, and desktop components
RUN apt-get update && apt-get install -y --no-install-recommends \
    # X11 and virtual framebuffer
    xvfb \
    x11-utils \
    xdotool \
    xclip \
    # GStreamer core
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-x \
    gstreamer1.0-pulseaudio \
    # Hardware acceleration (VAAPI)
    gstreamer1.0-vaapi \
    libva2 \
    vainfo \
    # Python for selkies
    python3 \
    python3-pip \
    python3-gi \
    python3-gi-cairo \
    gir1.2-gst-plugins-base-1.0 \
    gir1.2-gstreamer-1.0 \
    # Desktop environment (lightweight)
    openbox \
    xterm \
    # Networking and utilities
    ca-certificates \
    curl \
    git \
    jq \
    openssh-client \
    dbus-x11 \
    libpulse0 \
    pulseaudio \
    # Fonts
    fonts-dejavu-core \
    # Build dependencies for evdev (required by pynput)
    linux-libc-dev \
    python3-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install selkies-gstreamer from GitHub releases
ARG SELKIES_VERSION=1.6.0
RUN pip3 install --no-cache-dir \
    websockets \
    aiohttp \
    prometheus_client \
    msgpack \
    pynput \
    Pillow \
    && pip3 install --no-cache-dir \
    "https://github.com/selkies-project/selkies-gstreamer/releases/download/v${SELKIES_VERSION}/selkies_gstreamer-${SELKIES_VERSION}-py3-none-any.whl"

# Create workspace and runtime directories
RUN mkdir -p /workspace /run/pulse /tmp/.X11-unix && \
    chmod 1777 /tmp/.X11-unix

# Copy the agent binary
COPY --from=builder /agent /usr/local/bin/agent

# Copy startup script
COPY deploy/docker/start-desktop.sh /usr/local/bin/start-desktop.sh
RUN chmod +x /usr/local/bin/start-desktop.sh

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash marionette && \
    chown -R marionette:marionette /workspace /run/pulse

USER marionette
WORKDIR /workspace

# Entry point starts Xvfb + desktop + agent
ENTRYPOINT ["/usr/local/bin/start-desktop.sh"]
