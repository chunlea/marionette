# Example secrets configuration
# Copy this file to secrets.yaml and fill in the values
# Then apply with: kubectl apply -f secrets.yaml
#
# IMPORTANT: Do NOT commit secrets.yaml to version control
#
# Generate random keys with:
#   openssl rand -base64 32

apiVersion: v1
kind: Secret
metadata:
  name: marionette-secrets
  labels:
    app.kubernetes.io/name: marionette
type: Opaque
stringData:
  # PostgreSQL connection string
  database-url: "postgres://marionette:CHANGE_ME@postgres:5432/marionette?sslmode=disable"

  # Master key for admin operations (32+ characters)
  master-key: "CHANGE_ME_TO_A_SECURE_RANDOM_STRING"

  # Encryption key for agent credentials (exactly 32 bytes)
  encryption-key: "CHANGE_ME_EXACTLY_32_CHARACTERS!"

  # Admin UI credentials
  ui-username: "admin"
  ui-password: "CHANGE_ME"

  # Runner authentication token
  runner-token: "CHANGE_ME_RUNNER_TOKEN"
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  labels:
    app.kubernetes.io/name: marionette
    app.kubernetes.io/component: postgres
type: Opaque
stringData:
  username: "marionette"
  password: "CHANGE_ME"
